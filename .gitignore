# ── Pipeline work directories ─────────────────────────────────────────────────
# Content-addressed stage outputs written by ArtifactStore
run_*/
work/

# ── Audio / MIDI scratch files (fixtures are kept; scratch outputs are not) ───
# Keep: tests/fixtures/*.mid  tests/fixtures/*.wav  tests/fixtures/*.json
# Ignore: anything generated at pipeline runtime
outputs/
stems/
renders/
*.flac
*.mp3
*.aiff
*.ogg

# ── Model weights & large blobs ───────────────────────────────────────────────
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.onnx
*.h5

# ── Configs with secrets ──────────────────────────────────────────────────────
.env
.env.*
secrets.yaml
secrets.json

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── mypy / pyright / ruff ─────────────────────────────────────────────────────
